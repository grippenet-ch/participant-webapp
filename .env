# App configuration (owned by this repo, never touched by copier update).
# Mode-specific overrides: .env.development, .env.production.local (Vite precedence).
# Other builds: `make docker ENV_FILE=.env.minikube` (local.grippenet.ch reCAPTCHA key).
# CSP lives in nginx/snippets/csp.conf; REACT_APP_VERSION / SURVEY_ENGINE_VERSION come from package.json (kit Vite preset).
REACT_APP_CONTENT_URL=/assets
REACT_APP_API_BASE_URL=/api
REACT_APP_DEFAULT_INSTANCE=switzerland
REACT_APP_DEFAULT_LANGUAGE="fr"
REACT_APP_FALLBACK_LANGUAGE="en"
REACT_APP_USE_RECAPTCHA=true
REACT_APP_RECAPTCHA_SITEKEY=6Lf0uPUfAAAAALmxoQode_h6RP70_XdeHw1OqJkz
REACT_APP_TITLE="Grippenet"
REACT_APP_DESCRIPTION="A voluntary participation system for monitoring covid and influenza in Switzerland"
